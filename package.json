{
  "name": "pi-dswa",
  "version": "1.0.0",
  "description": "DeepSeek Web Access for Pi: official web search and fetch tools.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "deepseek",
    "web-search",
    "web-fetch"
  ],
  "author": "YogiLiu",
  "license": "BSD-3-Clause",
  "pi": {
    "extensions": [
      "./extensions/dswa.ts"
    ]
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22.19.19",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
