{
  "name": "pi-dswa",
  "version": "0.3.0",
  "description": "DeepSeek Web Access for Pi: official web search and fetch tools.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "deepseek",
    "web-search",
    "web-fetch"
  ],
  "author": "YogiLiu",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YogiLiu/dswa.git"
  },
  "homepage": "https://github.com/YogiLiu/dswa#readme",
  "bugs": {
    "url": "https://github.com/YogiLiu/dswa/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.12",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
